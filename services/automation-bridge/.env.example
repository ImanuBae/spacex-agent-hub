HOST=127.0.0.1
PORT=4006
DATABASE_URL=postgresql://automation_bridge:replace-me@127.0.0.1:5432/automation_bridge
RABBITMQ_URL=amqp://automation_bridge:replace-me@127.0.0.1:5672
AUTH_SECRET=replace-with-IAM-shared-secret-at-least-32-bytes
AUTH_ISSUER=spacex-identity
AUTH_AUDIENCE=spacex-services
IDENTITY_URL=http://127.0.0.1:4002
# No business trigger enabled. Register reviewed reference-only mappings before subscribing.
AUTOMATION_BINDINGS=[]
AUTOMATION_EVENT_PATTERNS=[]
# Use the public key of the actual IAM authority. Every request also requires live IAM introspection.
# Without this configuration, internal job APIs fail closed with 503.
# AUTOMATION_MACHINE_PUBLIC_KEY_FILE=/secure/iam-machine-public.pem
# AUTOMATION_MACHINE_ISSUER=spacex-machine-identity
AUTOMATION_MACHINE_SUBJECTS={}
