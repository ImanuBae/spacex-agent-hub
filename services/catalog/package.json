{
  "name": "@spacex/catalog",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --env-file-if-exists=.env --watch dist/index.js",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test": "vitest run",
    "test:db": "node --env-file-if-exists=.env scripts/test-db.mjs",
    "lint": "eslint src",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "demo:messaging": "node --env-file-if-exists=.env dist/messaging-demo.js"
  },
  "dependencies": {
    "@spacex/config": "*",
    "@spacex/contracts": "*",
    "@spacex/logger": "*",
    "@spacex/messaging": "*",
    "drizzle-orm": "^0.45.4",
    "express": "^5.1.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15"
  }
}
