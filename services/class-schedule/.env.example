HOST=127.0.0.1
PORT=4004
DATABASE_URL=postgresql://class_schedule:class_schedule_dev@127.0.0.1:55432/class_schedule
AUTH_SECRET=replace-with-the-same-secret-as-identity-at-least-32-bytes
IDENTITY_URL=http://127.0.0.1:4002
ORG_URL=http://127.0.0.1:4003
CATALOG_URL=http://127.0.0.1:4001
# Disabled by default. Fixture hold endpoints require both flags.
APP_ENV=development
CLASS_DEMO_ENABLED=false
# Business default: 20 minutes. Override only in demo; UI displays actual value.
CLASS_DEMO_HOLD_TTL_SECONDS=1200
# Optional internal Enrollment credential, minimum 32 bytes. Never forwarded by BFF.
ENROLLMENT_SERVICE_SECRET=
# Optional for the synchronous demo. When unset, events remain durably PENDING.
# Provision durable consumer bindings before enabling publication.
RABBITMQ_URL=
