SERVICE_NAME=identity
PORT=4002
DATABASE_URL=postgresql://identity_access:identity_access_dev@127.0.0.1:5432/identity_access
# Generate a random secret of at least 32 bytes; identical on IAM/Gateway/Org/Catalog.
AUTH_SECRET=
AUTH_ISSUER=spacex-identity
AUTH_AUDIENCE=spacex-services
IDENTITY_URL=http://127.0.0.1:4002
ORG_URL=http://127.0.0.1:4003
# Seed only; password minimum 12 characters. No default password is created.
SEED_ADMIN_EMAIL=director@spacex.local
SEED_ADMIN_PASSWORD=
