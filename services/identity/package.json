{
  "name": "@spacex/identity",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "dev": "node --env-file-if-exists=.env --watch dist/index.js",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "db:migrate": "tsx --env-file-if-exists=.env src/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/seed.ts",
    "test:db": "node scripts/test-db.mjs"
  },
  "dependencies": {
    "@spacex/auth": "*",
    "@spacex/config": "*",
    "@spacex/contracts": "*",
    "@spacex/http": "*",
    "@spacex/logger": "*",
    "express": "^5.1.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@spacex/catalog": "*",
    "@spacex/gateway": "*",
    "@spacex/org": "*",
    "@types/express": "^5.0.0",
    "@types/pg": "^8.23.1",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15"
  }
}
