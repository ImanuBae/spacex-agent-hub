{
  "name": "spacex-agent-hub",
  "private": true,
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*",
    "templates/service"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=!@spacex/service-template",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test build",
    "dev:template": "npm run build && npm run dev --workspace=@spacex/service-template",
    "demo:messaging": "npm run build && npm run demo:messaging --workspace=@spacex/service-template",
    "demo:class": "node scripts/demo-class.mjs",
    "test:class:db": "npm run test:db --workspace=@spacex/class-schedule",
    "test:reliability": "npm run test:db --workspace=@spacex/messaging",
    "test:stage2:browser": "node scripts/test-stage2-browser.mjs",
    "test:crm:db": "npm run test:db --workspace=@spacex/crm",
    "test:crm:browser": "node scripts/test-crm-browser.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
