              },
              {
                "name": "Connection",
                "value": "close"
              }
            ]
          },
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ { jobId:$('Job').first().json.jobId,leaseToken:$('Job').first().json.leaseToken,attempt:$('Job').first().json.attempt } }}",
          "options": {
            "timeout": 3000,
            "redirect": {
              "redirect": {
                "followRedirects": false
              }
            },
            "response": {
              "response": {
                "neverError": true
              }
            }
          }
        },
        "onError": "continueRegularOutput"
      },
      {
        "id": "Finish",
        "name": "Finish",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1680,
          200
        ],
        "parameters": {
          "jsCode": "const e=$json.error, retry=e&&(!e.code||/UNAVAILABLE|TIMEOUT|NETWORK/.test(e.code));return [{json:{...{ leaseToken:$('Job').first().json.leaseToken,attempt:$('Job').first().json.attempt,expectedVersion:$('Job').first().json.version,step:'chat' },expectedVersion:$('Intent').first().json.data.version,outcome:retry?'RETRY':e?'DEAD':'DONE',...(e?{errorCode:retry?'UPSTREAM_UNAVAILABLE':'CONVERSATION_DENIED'}:{}),resultRef:'conversation:'+$('Job').first().json.entity.id}}];"
        }
      },
      {
        "id": "Result",
        "name": "Result",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          1920,
          200
        ],
        "parameters": {
          "method": "POST",
          "url": "={{ 'http://host.docker.internal:4006/internal/automation/jobs/' + $('Job').first().json.jobId + '/result' }}",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "Authorization",
                "value": "={{ 'Bearer ' + $('Machine token').first().json.data.accessToken }}"
              },
              {
                "name": "Connection",
                "value": "close"
              }
            ]
          },
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ $json }}",
          "options": {
            "timeout": 3000,
            "redirect": {
              "redirect": {
                "followRedirects": false
              }
            },
            "response": {
              "response": {
                "neverError": true
              }
            }
          }
        },
        "onError": "continueRegularOutput"
