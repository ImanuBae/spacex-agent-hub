          "genericAuthType": "httpCustomAuth",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "{\"audience\":\"automation-bridge\",\"scopes\":[\"automation:claim\",\"automation:checkpoint\",\"automation:result\",\"automation:authorize\"],\"workflows\":[\"WF-03\"],\"ttlSeconds\":60}",
          "options": {
            "timeout": 3000
          }
        },
        "credentials": {
          "httpCustomAuth": {
            "id": "N8N04WF-03Machine",
            "name": "WF-03-machine-client"
          }
        }
      },
      {
        "id": "Claim",
        "name": "Claim",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          720,
          200
        ],
        "parameters": {
          "method": "POST",
          "url": "http://host.docker.internal:4006/internal/automation/jobs/claim",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "Authorization",
                "value": "={{ 'Bearer ' + $('Machine token').first().json.data.accessToken }}"
              },
              {
                "name": "Connection",
                "value": "close"
              }
            ]
          },
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ {\"workflowId\":\"WF-03\",\"workflowVersion\":1} }}",
          "options": {
            "timeout": 3000,
            "redirect": {
              "redirect": {
                "followRedirects": false
              }
            },
            "response": {
              "response": {
                "neverError": true
              }
            }
          }
        },
        "onError": "continueRegularOutput"
      },
      {
        "id": "Job",
        "name": "Job",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          960,
          200
        ],
        "parameters": {
          "jsCode": "const job=$json.data; return job ? [{json:{...job,startedAt:Date.now()}}] : [];"
        }
      },
      {
        "id": "Intent",
        "name": "Intent",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          1200,
          200
        ],
        "parameters": {
          "method": "POST",
          "url": "={{ 'http://host.docker.internal:4006/internal/automation/jobs/' + $('Job').first().json.jobId + '/checkpoint' }}",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "Authorization",
                "value": "={{ 'Bearer ' + $('Machine token').first().json.data.accessToken }}"
              },
              {
                "name": "Connection",
                "value": "close"
              }
            ]
          },
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ { leaseToken:$('Job').first().json.leaseToken,attempt:$('Job').first().json.attempt,expectedVersion:$('Job').first().json.version,step:'chat',operation:{name:'conversation.handoff'} } }}",
          "options": {
            "timeout": 3000,
            "redirect": {
              "redirect": {
                "followRedirects": false
              }
            },
            "response": {
              "response": {
                "neverError": true
              }
            }
          }
        },
        "onError": "continueRegularOutput"
      },
      {
